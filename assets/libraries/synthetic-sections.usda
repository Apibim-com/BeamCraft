#usda 1.0
(
    doc = "Synthetic profile library for BeamCraft tests. Contributor-original, MPL-2.0. Every value is invented; none follows or reproduces any national standard, manufacturer catalogue or commercial table."
    metersPerUnit = 0.001
    upAxis = "Z"
    customLayerData = {
        string "bim:library:id" = "beamcraft-synthetic"
        string "bim:library:title" = "BeamCraft synthetic test sections"
        string "bim:library:version" = "1"
        string "bim:library:source" = "Contributor-original synthetic values for tests; no standard, catalogue or vendor data"
        string "bim:library:licence" = "MPL-2.0"
    }
)

def Scope "Library"
{
    def Scope "Profiles"
    {
        def Scope "SYN_I_300x150"
        {
            string steel:profile:designation = "SYN-I-300x150"
            token steel:profile:family = "i_shape"
            double steel:profile:hMm = 300
            double steel:profile:bMm = 150
            double steel:profile:twMm = 7
            double steel:profile:tfMm = 10
            double steel:profile:rMm = 15
            double steel:profile:areaMm2 = 5153
            double steel:profile:massPerMeterKg = 40.45
        }

        def Scope "SYN_I_200x100"
        {
            string steel:profile:designation = "SYN-I-200x100"
            token steel:profile:family = "i_shape"
            double steel:profile:hMm = 200
            double steel:profile:bMm = 100
            double steel:profile:twMm = 5
            double steel:profile:tfMm = 8
            double steel:profile:rMm = 10
        }

        def Scope "SYN_C_200x75"
        {
            string steel:profile:designation = "SYN-C-200x75"
            token steel:profile:family = "channel"
            double steel:profile:hMm = 200
            double steel:profile:bMm = 75
            double steel:profile:twMm = 6
            double steel:profile:tfMm = 9
            double steel:profile:rMm = 10
        }

        def Scope "SYN_L_100x100x8"
        {
            string steel:profile:designation = "SYN-L-100x100x8"
            token steel:profile:family = "angle"
            double steel:profile:hMm = 100
            double steel:profile:bMm = 100
            double steel:profile:tMm = 8
            double steel:profile:rMm = 10
        }

        def Scope "SYN_RHS_100x60x4"
        {
            string steel:profile:designation = "SYN-RHS-100x60x4"
            token steel:profile:family = "rhs"
            double steel:profile:hMm = 100
            double steel:profile:bMm = 60
            double steel:profile:tMm = 4
            double steel:profile:rMm = 8
        }

        def Scope "SYN_CHS_114x5"
        {
            string steel:profile:designation = "SYN-CHS-114x5"
            token steel:profile:family = "chs"
            double steel:profile:dMm = 114
            double steel:profile:tMm = 5
        }

        def Scope "SYN_LC_150x60x20x2"
        {
            string steel:profile:designation = "SYN-LC-150x60x20x2"
            token steel:profile:family = "lipped_c"
            double steel:profile:hMm = 150
            double steel:profile:bMm = 60
            double steel:profile:cMm = 20
            double steel:profile:tMm = 2
            double steel:profile:rMm = 4
        }

        def Scope "SYN_BAR_100x20"
        {
            string steel:profile:designation = "SYN-BAR-100x20"
            token steel:profile:family = "rectangle"
            double steel:profile:hMm = 100
            double steel:profile:bMm = 20
            double steel:profile:areaMm2 = 2000
        }

        def Scope "SYN_TEE_CUSTOM"
        {
            string steel:profile:designation = "SYN-TEE-CUSTOM"
            token steel:profile:family = "custom"
            double3[] steel:profile:outerPointsMm = [(0, 0, 0), (100, 0, 0), (100, 10, 0), (60, 10, 0), (60, 80, 0), (40, 80, 0), (40, 10, 0), (0, 10, 0)]
            double steel:profile:areaMm2 = 2400
        }
    }
}
